# RunLab 운영 환경변수 — 이 파일을 복사해 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# 그다음:  docker compose up -d --build

# ── 필수 ──
# 도메인 (호스팅케이알에서 산 주소). Caddy가 이 주소로 HTTPS 인증서를 발급.
SITE_DOMAIN=runlab.ai.kr
# 접속 허용 도메인 (보통 SITE_DOMAIN과 같게. 여러 개면 공백으로 구분)
ALLOWED_HOSTS=runlab.ai.kr www.runlab.ai.kr
# 운영 모드 (0=운영). 반드시 0.
DEBUG=0
# 비밀 키 — 아래 명령으로 만들어 붙여넣기:
#   docker compose run --rm app python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=여기에-생성한-키-붙여넣기
# sqlite DB 위치 (볼륨에 영구 보관 — 건드리지 마세요)
DB_PATH=/app/backend/data/db.sqlite3

# ── 관리자·데모 비밀번호 (반드시 바꾸세요) ──
ADMIN_PASSWORD=여기에-강한-관리자비번
DEMO_PASSWORD=여기에-데모비번
